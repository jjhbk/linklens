MERCHANT_WALLET=0xYourBaseReceivingWallet
CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
ERC7710_FACILITATOR_URL=https://tx-sentinel-base-mainnet.api.cx.metamask.io/platform/v2/x402
# Optional: provision the receiving wallet through Coinbase CDP when MERCHANT_WALLET is unset.
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret
CDP_WALLET_SECRET=your_cdp_wallet_secret
CDP_WALLET_NAME=link-lens-merchant
# Optional AP2 merchant Checkout JWT signing. AP2 remains disabled unless issuer and PEM are both set.
MERCHANT_AP2_ISSUER=https://your-service.example
MERCHANT_AP2_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
MERCHANT_AP2_KEY_ID=merchant-ap2-1
